    },
    "wearEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "outfitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "date",
        "itemIds"
      ],
      "additionalProperties": true
    },
    "vocabularies": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "maxLength": 50000
              },
              "role": {
                "enum": [
                  "top",
                  "bottom",
                  "dress",
                  "outerwear",
                  "shoes",
                  "bag",
                  "accessory",
                  "hosiery"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "role"
            ],
            "additionalProperties": true
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000,
          "minItems": 1
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "maxLength": 50000
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "neutral": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "hex",
              "neutral"
            ],
            "additionalProperties": true
          }
        },
        "occasions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000,
          "minItems": 1
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000,
          "minItems": 1
