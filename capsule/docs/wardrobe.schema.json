        },
        "garmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "garmentId",
        "priority",
        "notes",
        "budget"
      ],
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 50000
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "kind": {
          "type": "string",
          "maxLength": 50000
        }
      },
      "required": [
        "id",
        "title",
        "itemIds",
        "notes",
        "styles",
        "kind"
      ],
