      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50000
        },
        "temperature": {
          "type": "number",
          "minimum": -60,
          "maximum": 65
        },
        "occasion": {
          "type": "string",
          "maxLength": 50000
        },
        "style": {
          "type": "string",
          "maxLength": 50000
        },
        "currency": {
          "enum": [
            "EUR",
            "USD",
            "GBP",
            "CHF",
            "CAD",
            "JPY"
          ]
        }
      },
      "required": [
        "name",
        "temperature",
        "occasion",
        "style",
        "currency"
      ],
      "additionalProperties": true
    }
  }
