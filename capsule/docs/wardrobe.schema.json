{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier Wardrobe v1",
  "description": "Les références d’IDs, doublons, chemins d’images et plages de températures sont également contrôlés par src/storage.ts.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "garments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/garment"
      }
    },
    "outfits": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/outfit"
      }
    },
    "wishlist": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/wishlist"
      }
    },
    "inspirations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/inspiration"
      }
    },
    "boards": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/board"
      }
    },
    "wearEvents": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/wearEvent"
      }
    },
    "vocabularies": {
      "$ref": "#/$defs/vocabularies"
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "legacy": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "garments",
    "outfits",
    "wishlist",
    "inspirations",
    "boards",
    "wearEvents",
    "vocabularies",
    "preferences",
    "legacy"
  ],
  "additionalProperties": true,
  "$defs": {
    "garment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 50000,
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "maxLength": 50000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subcategory": {
          "type": "string",
          "maxLength": 50000
        },
        "role": {
          "enum": [
            "top",
            "bottom",
            "dress",
            "outerwear",
            "shoes",
            "bag",
            "accessory",
            "hosiery"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "secondaryColors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "pattern": {
          "type": "string",
          "maxLength": 50000
        },
        "material": {
          "type": "string",
          "maxLength": 50000
        },
        "fit": {
          "type": "string",
          "maxLength": 50000
        },
        "silhouette": {
          "type": "string",
          "maxLength": 50000
        },
        "length": {
          "type": "string",
          "maxLength": 50000
        },
        "sleeve": {
          "type": "string",
          "maxLength": 50000
        },
        "neckline": {
          "type": "string",
          "maxLength": 50000
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "warmth": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "temperature": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 65
                },
                {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 65
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "formality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "occasions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "layeringRole": {
          "type": "string",
          "maxLength": 50000
        },
        "imagePath": {
          "type": "string",
          "maxLength": 7340032,
          "description": "Chemin relatif images/… ou data URI raster. Les URL distantes, SVG et traversées de répertoires sont refusées par le validateur applicatif."
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        },
        "favorite": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "owned",
            "wishlist"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "forSale": {
          "type": "boolean"
        },
        "usageCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastWorn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reviewNeeded": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "category",
        "subcategory",
        "role",
        "colors",
        "secondaryColors",
        "pattern",
        "material",
        "fit",
        "silhouette",
        "length",
        "sleeve",
        "neckline",
        "details",
        "warmth",
        "seasons",
        "temperature",
        "styles",
        "formality",
        "occasions",
        "layeringRole",
        "imagePath",
        "notes",
        "favorite",
        "status",
        "archived",
        "forSale",
        "usageCount",
        "lastWorn",
        "price",
        "reviewNeeded"
      ],
      "additionalProperties": true
    },
    "outfit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 50000
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "occasions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "temperature": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 65
                },
                {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 65
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        },
        "imagePath": {
          "type": "string",
          "maxLength": 7340032,
          "description": "Chemin relatif images/… ou data URI raster. Les URL distantes, SVG et traversées de répertoires sont refusées par le validateur applicatif."
        },
        "source": {
          "enum": [
            "manual",
            "generated",
            "inspiration"
          ]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50000
        }
      },
      "required": [
        "id",
        "name",
        "itemIds",
        "styles",
        "occasions",
        "seasons",
        "temperature",
        "rating",
        "notes",
        "imagePath",
        "source",
        "createdAt"
      ],
      "additionalProperties": true
    },
    "recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "maxLength": 50000
        },
        "role": {
          "enum": [
            "top",
            "bottom",
            "dress",
            "outerwear",
            "shoes",
            "bag",
            "accessory",
            "hosiery"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "label",
        "role",
        "colors",
        "styles",
        "details"
      ],
      "additionalProperties": true
    },
    "inspiration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 50000
        },
        "imagePath": {
          "type": "string",
          "maxLength": 7340032,
          "description": "Chemin relatif images/… ou data URI raster. Les URL distantes, SVG et traversées de répertoires sont refusées par le validateur applicatif."
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50000
          },
          "maxItems": 10000
        },
        "recipe": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe"
          },
          "maxItems": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        }
      },
      "required": [
        "id",
        "title",
        "imagePath",
        "description",
        "styles",
        "palette",
        "recipe",
        "notes"
      ],
      "additionalProperties": true
    },
    "wishlist": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
